generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())

  @@map("users")
}

model Post {
  id            String            @id @default(uuid())
  previewFileId String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  publishedAt   DateTime          @default(now())
  title         String            @db.VarChar(200)
  description   String?           @db.LongText
  content       String?           @db.LongText
  slug          String            @unique @db.VarChar(250)
  isPublished   Boolean           @default(false)
  isDeleted     Boolean           @default(false)
  departmentId  String?
  isPinned      Boolean           @default(false)
  Slide         MainSliderSlide[]
  Notification  Notification[]
  department    Department?       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  preview       File?             @relation("PostPreviewFile", fields: [previewFileId], references: [id])
  tags          TagsOnPosts[]

  /// Тело новости без HTML-тегов. Генерируемая STORED-колонка (см. миграцию
  /// 20260903..._posts_fulltext_search) — заполняется MySQL/MariaDB автоматически
  /// из `content`, приложение её не пишет. Используется только для FULLTEXT-поиска.
  contentText String? @db.LongText

  @@index([departmentId])
  @@index([previewFileId])
  @@fulltext([title, description, contentText])
  @@map("posts")
}

model Achievement {
  id        String   @id @default(uuid())
  label     String
  count     String
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("achievements")
}

model Department {
  id            String   @id @default(uuid())
  title         String   @db.VarChar(200)
  slug          String   @unique @db.VarChar(250)
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.DateTime(0)
  updatedAt     DateTime @updatedAt
  previewFileId String?
  preview       File?    @relation("DepartmentPreviewFile", fields: [previewFileId], references: [id])
  posts         Post[]

  @@index([previewFileId])
  @@map("departments")
}

model Tag {
  id        String        @id @default(uuid())
  title     String        @db.VarChar(200)
  slug      String        @unique @db.VarChar(250)
  createdAt DateTime      @default(now())
  posts     TagsOnPosts[]

  @@map("tags")
}

model TagsOnPosts {
  postId     String
  tagId      String
  assignedAt DateTime @default(now())
  post       Post     @relation(fields: [postId], references: [id])
  tag        Tag      @relation(fields: [tagId], references: [id])

  @@id([postId, tagId])
  @@index([tagId], map: "tags_on_posts_tagId_fkey")
  @@map("tags_on_posts")
}

model File {
  id             String            @id @default(uuid())
  originalName   String            @db.VarChar(200)
  mimeType       String            @db.VarChar(50)
  hash           String?           @unique @db.VarChar(64)
  type           FileType
  path           String            @db.VarChar(400)
  size           Int
  width          Int?
  height         Int?
  createdAt      DateTime          @default(now())
  BookCollection BookCollection[]  @relation("CollectionPreviewFile")
  books          Book[]            @relation("BookPreviewFile")
  departments    Department[]      @relation("DepartmentPreviewFile")
  club           Club[]            @relation("ClubPreviewFile")
  slide          MainSliderSlide[]
  posts          Post[]            @relation("PostPreviewFile")
  mapPoints      MapPoint[]
  gameImages     GameImage[]
  gameRulesFor   Game[]            @relation("GameRulesFile")

  @@map("files")
}

model Event {
  id        String   @id @default(uuid())
  title     String   @db.VarChar(500)
  content   String   @db.LongText
  phone     String   @db.VarChar(20)
  age       Int?
  place     String
  eventTime DateTime
  createdAt DateTime @default(now())
  isDeleted Boolean  @default(false)

  @@map("events")
}

model MainSliderSlide {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  isDeleted   Boolean  @default(false)
  slideOrder  Int      @default(0)
  postId      String?
  imageFileId String?
  url         String?
  image       File?    @relation(fields: [imageFileId], references: [id])
  post        Post?    @relation(fields: [postId], references: [id])

  @@index([imageFileId])
  @@index([slideOrder])
  @@index([postId])
  @@map("main_slider_slides")
}

model Notification {
  id          String           @id @default(uuid())
  title       String           @db.VarChar(200)
  description String           @db.VarChar(200)
  type        NotificationType
  postId      String?
  startTime   DateTime         @default(now())
  endTime     DateTime?
  isDeleted   Boolean          @default(false)
  post        Post?            @relation(fields: [postId], references: [id])

  @@index([postId])
  @@map("notifications")
}

model Book {
  id            String             @id @default(uuid()) @db.VarChar(250)
  slug          String             @unique @db.VarChar(250)
  title         String             @db.VarChar(200)
  description   String             @db.LongText
  content       String             @db.LongText
  previewFileId String?
  isDeleted     Boolean            @default(false)
  isVideo       Boolean            @default(false)
  place         String             @db.VarChar(200)
  litresLink    String?
  createdAt     DateTime           @default(now())
  preview       File?              @relation("BookPreviewFile", fields: [previewFileId], references: [id])
  collections   BookOnCollection[]

  @@index([previewFileId])
  @@map("books")
}

model BookCollection {
  id            String             @id @default(uuid())
  label         String
  isDeleted     Boolean            @default(false)
  previewFileId String?
  createdAt     DateTime           @default(now())
  preview       File?              @relation("CollectionPreviewFile", fields: [previewFileId], references: [id])
  books         BookOnCollection[]

  @@index([previewFileId])
  @@map("book_collection")
}

model BookOnCollection {
  bookId        String
  collectionsId String
  assignedAt    DateTime       @default(now())
  book          Book           @relation(fields: [bookId], references: [id])
  collections   BookCollection @relation(fields: [collectionsId], references: [id])

  @@id([bookId, collectionsId])
  @@index([collectionsId], map: "books_on_collections_collectionsId_fkey")
  @@map("books_on_collections")
}

model NavigationItem {
  id          String           @id @default(uuid())
  title       String           @db.VarChar(100)
  to          String?          @db.VarChar(500)
  slug        String           @unique @db.VarChar(100)
  description String?          @db.VarChar(200)
  icon        String?          @db.VarChar(50)
  order       Int              @default(0)
  isExternal  Boolean          @default(false)
  target      String           @default("_self")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  parentId    String?
  parent      NavigationItem?  @relation("NavigationChildren", fields: [parentId], references: [id])
  children    NavigationItem[] @relation("NavigationChildren")

  @@index([parentId])
  @@index([order])
  @@map("navigation_items")
}

model Page {
  id        String  @id @default(uuid())
  title     String  @db.VarChar(200)
  content   String? @db.LongText
  isDeleted Boolean @default(false)
  slug      String? @unique @db.VarChar(200)
  blocks    Json?

  @@map("pages")
}

model Club {
  id            String @id @default(uuid())
  name          String @db.VarChar(80)
  description   String @db.VarChar(1024)
  member        String @db.VarChar(128)
  worktime      String @db.VarChar(64)
  workDirection Json

  previewFileId String?
  preview       File?   @relation("ClubPreviewFile", fields: [previewFileId], references: [id])

  @@index([previewFileId])
  @@map("clubs")
}

model MapPoint {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(200)
  description String?  @db.VarChar(500)
  imageFileId String?
  content     String?  @db.LongText
  lat         Float
  lng         Float
  preset      String?  @db.VarChar(100)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  image       File?    @relation(fields: [imageFileId], references: [id])

  @@index([imageFileId])
  @@map("map_points")
}

enum GameStatus {
  IN_STOCK
  ON_HANDS
  TEMPORARILY_UNAVAILABLE
  WRITTEN_OFF
  LOST
  DAMAGED
}

model Game {
  id               String          @id @default(uuid())
  slug             String          @unique @db.VarChar(300)
  externalId       String?         @unique @db.VarChar(32)
  title            String          @db.VarChar(256)
  shortDescription String?         @db.VarChar(512)
  description      String?         @db.LongText
  playerMin        Int?
  playerMax        Int?
  playerAge        Int?
  durationMin      Int?
  durationMax      Int?
  year             Int?
  status           GameStatus      @default(IN_STOCK)
  place            String?         @db.VarChar(512)
  comment          String?         @db.VarChar(1024)
  isDeleted        Boolean         @default(false)
  videoUrl         String?         @db.VarChar(500)
  seriesId         String?
  series           GameSeries?     @relation(fields: [seriesId], references: [id])
  rulesFileId      String?
  rulesFile        File?           @relation("GameRulesFile", fields: [rulesFileId], references: [id])
  images           GameImage[]
  genres           GenresOnGames[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([seriesId])
  @@index([rulesFileId])
  @@fulltext([title, shortDescription, description])
  @@map("games")
}

model GameImage {
  id     String @id @default(uuid())
  gameId String
  fileId String
  order  Int    @default(0)
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  file   File   @relation(fields: [fileId], references: [id])

  @@unique([gameId, fileId])
  @@index([gameId])
  @@index([fileId], map: "game_images_fileId_fkey")
  @@map("game_images")
}

model GameGenre {
  id    String          @id @default(uuid())
  tag   String          @unique @db.VarChar(32)
  title String          @db.VarChar(64)
  games GenresOnGames[]

  @@map("game_genres")
}

model GenresOnGames {
  gameId  String
  genreId String
  game    Game      @relation(fields: [gameId], references: [id])
  genre   GameGenre @relation(fields: [genreId], references: [id])

  @@id([gameId, genreId])
  @@index([genreId], map: "genres_on_games_genreId_fkey")
  @@map("genres_on_games")
}

model GameSeries {
  id          String   @id @default(uuid())
  slug        String   @unique @db.VarChar(300)
  title       String   @db.VarChar(256)
  description String?  @db.VarChar(1024)
  createdAt   DateTime @default(now())
  games       Game[]

  @@map("game_series")
}

enum FileType {
  IMAGE
  DOCUMENT
  VIDEO
  AUDIO
  ARCHIVE
  OTHER
  EXHIBITION
}

enum NotificationType {
  success
  warning
  error
  festive
}
